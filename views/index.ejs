<%- include('./layout/header') %>

<main class="container">
  
  <!-- Hero Section -->
  <div class="hero-section">
    <span class="tag tag-yellow snippet-library-tag">SNIPPET LIBRARY</span>
    <h1 class="hero-title">
      Ready-to-use <span class="highlight-red">code snippets</span><br>
      for your next project.
    </h1>
    <p class="hero-desc">
      Browse scrapers, APIs, UI components, utilities, and algorithms. Copy what you need, drop it into your project, or contribute your own.
    </p>
    
    <div class="hero-actions">
      <a href="#gallery" class="btn-neo black-btn" style="text-decoration: none;">
        Browse snippets &darr;
      </a>
      <a href="#" class="btn-neo red-btn" style="text-decoration: none;">
        <i class="fas fa-heart"></i> Support gw
      </a>
    </div>
  </div>

  <!-- Browse Gallery Header -->
  <div class="gallery-section" id="gallery">
    <h2 class="section-title">Browse the gallery</h2>
    
    <!-- Filters & Search -->
    <div class="controls-wrapper">
      <div class="filter-tags">
        <span class="tag tag-yellow filter-active">ALL <span class="count">33</span></span>
        <span class="tag filter-tag">DOWNLOADER <span class="count">8</span></span>
        <span class="tag filter-tag">MAKER <span class="count">5</span></span>
        <span class="tag filter-tag">TOOLS <span class="count">7</span></span>
        <span class="tag filter-tag">AI <span class="count">2</span></span>
        <span class="tag filter-tag">SEARCH <span class="count">3</span></span>
        <span class="tag filter-tag">CONVERT <span class="count">6</span></span>
        <span class="tag filter-tag">STALKER <span class="count">2</span></span>
      </div>
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search snippets...">
      </div>
    </div>

    <!-- Alert Error (Jika ada error dari server) -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="card error-card">
        <i class="fas fa-exclamation-triangle"></i> <%= error %>
      </div>
    <% } %>

    <!-- Snippet Grid -->
    <% if (snippets && snippets.length > 0) { %>
      <div class="snippet-grid">
        <% snippets.forEach((snippet, index) => { 
            // Menentukan warna icon secara acak/berurutan berdasarkan index untuk contoh tampilan
            const colors = ['red', 'purple', 'pink', 'blue', 'green'];
            const colorClass = colors[index % colors.length];
        %>
          <div class="card snippet-card">
            
            <div class="card-header">
              <div class="icon-box icon-<%= colorClass %>">
                <i class="fas fa-file-code"></i>
              </div>
              <div class="category-badge badge-<%= colorClass %>">
                <%= typeof snippet.category !== 'undefined' ? snippet.category : 'MAKER' %>
              </div>
            </div>

            <div class="card-body">
              <h3 class="card-title"><%= snippet.filename.replace('.mjs', '').replace('.js', '').replace(/_/g, ' ').toUpperCase() %></h3>
              <p class="card-filename"><%= snippet.filename %></p>
              <span class="small-tech-tag">#node.js</span>
            </div>

            <hr class="card-divider">

            <div class="card-footer">
              <div class="meta-data">
                <div class="meta-col">
                  <span class="meta-label">TAGS</span>
                  <span class="meta-value">#node.js</span>
                </div>
                <div class="meta-col">
                  <span class="meta-label">LANG</span>
                  <span class="meta-value"><%= snippet.language || 'javascript' %></span>
                </div>
              </div>
              
              <a href="/files/<%= encodeURIComponent(snippet.filename) %>" class="btn-neo black-btn block-btn">
                View details &rarr;
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="card empty-state">
        <i class="fas fa-folder-open empty-icon"></i>
        <h3>No snippets yet</h3>
        <p>Be the first to create a snippet and share your code.</p>
        <a href="/admin" class="btn-neo black-btn" style="text-decoration: none;">Create Snippet</a>
      </div>
    <% } %>

    <!-- Pagination -->
    <div class="pagination-wrapper">
      <div class="pagination">
        <a href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>" class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>">&lsaquo;</a>
        
        <span class="page-btn active"><%= currentPage %></span>
        <% if (snippets && snippets.length >= 10) { %> <!-- Asumsi 10 per halaman -->
          <a href="?page=<%= currentPage + 1 %>" class="page-btn"><%= currentPage + 1 %></a>
          <a href="?page=<%= currentPage + 2 %>" class="page-btn"><%= currentPage + 2 %></a>
        <% } %>
        
        <a href="?page=<%= currentPage + 1 %>" class="page-btn">&rsaquo;</a>
      </div>
      <p class="page-info">Page <%= currentPage %> of 3 - 33 snippets</p>
    </div>

  </div>
</main>

<%- include('./layout/footer') %>
