<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'Snippet' %> - CodeSpace</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="logo">CodeSpace<span class="dot">.</span></div>
        <div class="nav-actions">
            <button class="btn-neo badge-btn"><i class="fa-regular fa-eye"></i> 302</button>
            <div class="notification"><i class="fa-regular fa-bell"></i><span class="notif-badge">2</span></div>
            <button class="btn-neo menu-btn">Menu</button>
        </div>
    </nav>

    <main class="container">
        <a href="/" class="back-link">&larr; back to gallery</a>

        <div class="breadcrumbs">
            src / snippets / <span class="current"><%= typeof filename != 'undefined' ? filename : 'snippet.js' %></span>
        </div>

        <h1 class="title"><%= typeof title != 'undefined' ? title : 'CODE SNIPPET' %></h1>

        <div class="tags-group">
            <span class="tag tag-yellow"><%= typeof language != 'undefined' ? language : 'javascript' %></span>
            <span class="tag tag-green">MAKER</span>
            <span class="tag tag-white"><i class="fa-regular fa-eye"></i> <%= typeof views != 'undefined' ? views : '18' %> views</span>
        </div>

        <div class="action-buttons">
            <button class="btn-neo icon-btn"><i class="fa-regular fa-file-lines"></i> RAW</button>
            <button class="btn-neo icon-btn"><i class="fa-solid fa-share-nodes"></i></button>
            <button class="btn-neo icon-btn"><i class="fa-regular fa-star"></i></button>
        </div>

        <p class="description"><%= typeof description != 'undefined' ? description : 'Snippet description here.' %></p>

        <div class="meta-tags">
            <span class="meta-tag">TAGS <strong>#<%= typeof language != 'undefined' ? language : 'coding' %></strong></span>
            <span class="meta-tag">LANG <strong><%= typeof language != 'undefined' ? language : 'javascript' %></strong></span>
        </div>

        <div class="code-window">
            <div class="window-header">
                <div class="mac-controls">
                    <span class="control close"></span>
                    <span class="control minimize"></span>
                    <span class="control maximize"></span>
                </div>
                <div class="filename"><%= typeof filename != 'undefined' ? filename : 'snippet.js' %></div>
                <div class="window-actions">
                    <button class="btn-neo small-btn"><i class="fa-solid fa-expand"></i> Expand</button>
                    <button class="btn-neo small-btn copy-btn"><i class="fa-regular fa-copy"></i> Copy</button>
                </div>
            </div>
            <div class="window-body">
                <div class="line-numbers">
                    <!-- Angka baris statis untuk contoh, bisa disesuaikan dengan loop EJS jika perlu -->
                    01<br>02<br>03<br>04<br>05<br>06<br>07<br>08<br>09<br>10<br>11<br>12<br>13<br>14
                </div>
                <pre class="code-editor"><code><%- typeof code != 'undefined' ? code : '// Your code here' %></code></pre>
            </div>
        </div>
    </main>
    <script src="/js/main.js"></script>
</body>
</html>
